# Copy to .env and adjust. Real environment variables override this file.

# local (Ollama, default) or echo
ADVISOR_LLM=local

# Local mode: a decision model picks the tools, a chat model answers.
#LOCAL_URL=http://localhost:11434
#LOCAL_ROUTER_MODEL=tev1:0.8b
#LOCAL_ANSWER_MODEL=qwen3:8b   # or gemma3:1b for a much lighter model

# Limits
#ADVISOR_RATE_LIMIT=4        # questions per player per minute
#ADVISOR_ASK_TIMEOUT=90      # seconds per question
#ADVISOR_LOG_LEVEL=INFO      # DEBUG also logs the prompts

# Building with !build (off by default). Only admins can build, plus these groups (comma-separated).
#BUILD_ENABLED=false
#BUILD_ALLOWED_GROUPS=
#BUILD_MAX_COST=1000         # most a single build may cost, in the park's currency
#BUILD_CASH_RESERVE=500      # cash the park keeps after a build
#BUILD_RATE_LIMIT=5          # builds per player per hour
#BUILD_PROPOSAL_TTL=120      # seconds a proposal waits for !yes
#BUILD_CHOOSE_POLICY=false   # let the decision model choose between busy spots and path junctions
